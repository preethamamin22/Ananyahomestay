generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Enum removed for SQLite compatibility; using string status field

model Booking {
  id        String         @id @default(cuid())
  name      String
  phone     String?
  email     String?
  roomId    String
  room      Room           @relation("RoomBookings", fields: [roomId], references: [id])
  checkin   DateTime
  checkout  DateTime
  guests    Int
  total     Int
  status    String @default("pending")
  notes     String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

model BlockedDate {
  id        Int      @id @default(autoincrement())
  roomId    String
  date      DateTime
  reason    String?
}


model Room {
  id       String @id
  name     String
  price    Int
  capacity Int
  status   String
  bookings Booking[] @relation("RoomBookings")
  bookingsCount Int    @default(0)
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  rating    Int
  review    String
  date      DateTime @default(now())
  approved  Boolean  @default(false)
}
